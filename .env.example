# Copy to .env and fill in. .env is git-ignored.
# Both services load it automatically at startup; a real environment
# variable of the same name takes precedence over anything set here.

# ---------------------------------------------------------------
# backend-ws  (WebSocket caption server)
# ---------------------------------------------------------------

# Which STT adapter to use: "mock" | "google"
# "mock" needs no credentials and is enough to exercise the whole
# mic -> WS -> caption path end to end.
WAYFINDER_STT=mock

# Detect the spoken language automatically instead of fixing it.
# Costs about a second at the start of a session while the language is
# worked out; captions are word-by-word live from then on.
STT_AUTO_DETECT=true

# BCP-47 language tag handed to the STT provider. With STT_AUTO_DETECT=true
# this is only the fallback, used when the language cannot be recognised.
STT_LANGUAGE=en-US

# Where detection runs. It needs a regional endpoint -- the model it uses
# does not exist in "global". Pick the one nearest your users:
# us-central1 | europe-west4 | asia-southeast1
GOOGLE_DETECT_LOCATION=us-central1

# Google Cloud Speech-to-Text v2 (only needed when WAYFINDER_STT=google)
# Recognition model. Google STT v2 names these "long", "short", "chirp", ...
STT_MODEL=long

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# ---------------------------------------------------------------
# backend-rest  (REST API server)
# ---------------------------------------------------------------

# Origins allowed to call the REST API and open the WebSocket.
CORS_ORIGINS=http://localhost:5173

# Guide mode's model: "mock" | "gemini" (Plan.md section 10).
# "mock" answers deterministically and needs no cloud project, which is
# enough to exercise the endpoints, the history, and the screenshot path.
WAYFINDER_LLM=mock

# Vision-capable model used when WAYFINDER_LLM=gemini. Reached through
# Vertex AI, so it authenticates with the same Application Default
# Credentials as speech-to-text -- no second API key.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LOCATION=us-central1

# Gemini 2.5 spends part of the output budget on internal reasoning, so a
# tight limit truncates the visible answer. Guide replies are short.
GEMINI_MAX_OUTPUT_TOKENS=400

# ---------------------------------------------------------------
# frontend  (Vite reads only VITE_-prefixed vars)
# ---------------------------------------------------------------

VITE_REST_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8001

# ---------------------------------------------------------------
# PostgreSQL (Plan.md section 6)
# ---------------------------------------------------------------
# Both services read this. backend-rest owns the schema and runs the
# migrations; backend-ws only reads a caption session and writes its lines.
# Create the role and database once:
#   psql -U postgres -c "CREATE ROLE wayfinder LOGIN PASSWORD 'choose-one';"
#   psql -U postgres -c "CREATE DATABASE wayfinder OWNER wayfinder;"
DATABASE_URL=postgresql+asyncpg://wayfinder:choose-one@127.0.0.1:5432/wayfinder

# Signing key for access and refresh tokens. Generate a fresh one per
# environment; anyone holding it can mint a token for any account:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
